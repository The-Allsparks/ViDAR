    "floorLutStatus": "example-placeholder-recalibrate-on-robot",
    "floorLut": [
      { "cy": 143, "dist": 12 },
      { "cy": 113, "dist": 24 },
      { "cy": 83, "dist": 36 },
      { "cy": 60, "dist": 48 }
