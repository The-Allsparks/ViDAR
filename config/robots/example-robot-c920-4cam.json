    {
      "index": 1,
      "webcamName": "Webcam 2",
      "name": "right",
      "mount": { "bearingDeg": 90, "x": 0, "y": -6.5, "z": 9.0 }
    },
    {
      "index": 2,
      "webcamName": "Webcam 3",
      "name": "back",
      "mount": { "bearingDeg": 180, "x": -6.5, "y": 0, "z": 9.0 }
    },
    {
      "index": 3,
      "webcamName": "Webcam 4",
      "name": "left",
      "mount": { "bearingDeg": 270, "x": 0, "y": 6.5, "z": 9.0 }
    }
  ]
