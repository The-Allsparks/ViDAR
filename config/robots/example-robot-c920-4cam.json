  "dimensions": {
    "length": 13.0,
    "width": 13.0,
    "height": 18.0
  },
  "alliance": {
    "defaultAlliance": "red",
    "colorSensorName": "alliance_color",
    "useColorSensor": true,
    "allowRuntimeToggle": true
  },
  "cameraDefaults": {
    "calibrationWidth": 1280,
    "calibrationHeight": 720,
